# PostgreSQL connection string. On Railway, add a Postgres plugin to your
# project and copy its DATABASE_URL (or reference ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://user:password@localhost:5432/kehila_network"

# Auth.js (NextAuth v5) secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Required when running behind a reverse proxy (Railway, Docker, etc.)
# so Auth.js trusts the forwarded host/protocol headers.
AUTH_TRUST_HOST="true"
