generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  seeker
  owner
  agent
  admin
}

enum ListingKind {
  long_term_rental
  short_term_rental
  sale
}

enum ListingStatus {
  draft
  pending_review
  live
  under_offer
  archived
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  country       String?
  role          UserRole  @default(seeker)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties    Property[]
  listings      Listing[]
  messages      Message[]

  @@map("users")
}

model Property {
  id                String   @id @default(uuid())
  addressLine1      String
  city              String
  region            String?
  country           String
  postalCode        String?
  propertyType      String
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  createdAt         DateTime @default(now())

  // Practical, place-based infrastructure info (not about the people who live there).
  shabbatElevator    Boolean?
  withinEruv         Boolean?
  kosherKitchen      Boolean?

  listings          Listing[]

  @@map("properties")
}

model Listing {
  id             String        @id @default(uuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id])
  title          String
  description    String
  listingKind    ListingKind
  status         ListingStatus @default(live)
  priceAmount    Decimal       @db.Decimal(12, 2)
  priceCurrency  String        @default("USD")
  bedrooms       Int?
  bathrooms      Int?
  sqft           Int?
  amenities      Json          @default("{}")
  photoUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  messages       Message[]

  @@map("listings")
}

model Message {
  id         String   @id @default(uuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@map("messages")
}
